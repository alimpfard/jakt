extern struct Optional<T> {
    fn has_value(this) -> bool
    fn value(this) -> T
    fn value_or(this, anon x: T) -> T
    fn Optional<S>(anon x: S) -> Optional<S>
    fn map<U>(this, anon mapper: fn(anon x: &T) -> U) -> Optional<U>
    fn map<U>(this, anon mapper: fn(anon x: &T) throws -> U) throws -> Optional<U>
}

extern struct ArrayIterator<T> {
    fn next(mut this) -> T?
}

[[name=DynamicArray]]
extern struct Array<T> {
    fn is_empty(this) -> bool
    fn contains(this, anon value: T) -> bool
    fn size(this) -> usize
    fn capacity(this) -> usize
    fn ensure_capacity(this, anon capacity: usize)
    fn add_capacity(this, anon capacity: usize)
    fn resize(mut this, anon size: usize)
    fn shrink(mut this, anon size: usize) -> void
    fn push(mut this, anon value: T)
    fn push_values(mut this, anon other: &Array<T>)
    fn pop(mut this) -> T?
    fn iterator(this) -> ArrayIterator<T>
    fn first(this) -> T?
    fn last(this) -> T?
    fn insert(mut this, before_index: usize, value: T)
    fn unsafe_data(this) -> raw T
}

extern struct ArraySlice<T> {
    fn is_empty(this) -> bool
    fn contains(this, anon value: T) -> bool
    fn size(this) -> usize
    fn iterator(this) -> ArrayIterator<T>
    fn to_array(this) -> Array<T>
    fn first(this) -> T?
    fn last(this) -> T?
    fn unsafe_data(this) -> raw T
}

[[name=DeprecatedStringCodePointIterator]]
extern struct CodePointIterator {
    fn next(mut this) -> u32?
    fn peek(this) -> u32?
    fn byte_offset(this) -> usize
}

[[name=ByteString]]
extern struct String {
    fn code_points(this) -> CodePointIterator
    fn from_utf8(anon bytes: [u8]) throws -> String
    fn number(anon number: i64) -> String
    fn split(this, anon c: c_char) -> [String]
    [[name=characters]]
    fn c_string(this) -> raw c_char
    fn to_number<T>(this) -> T?
    fn is_whitespace(this) -> bool
    fn hash(this) -> u32
    fn substring(this, start: usize, length: usize) -> String
    fn repeated(character: c_char, count: usize) -> String
    fn is_empty(this) -> bool
    fn length(this) -> usize
    fn byte_at(this, anon index: usize) -> u8
    fn contains(this, anon needle: String) -> bool
    fn replace(this, replace: String, with: String) -> String
    fn starts_with(this, anon needle: String) -> bool
    fn ends_with(this, anon needle: String) -> bool
    fn contains(this, anon needle: StringView) -> bool
}

[[name=ByteStringBuilder]]
extern struct StringBuilder {
    fn append(mut this, anon b: u8)
    fn append(mut this, anon s: StringView)
    fn append(mut this, anon s: String)
    fn append(mut this, string: raw c_char, size: usize)
    [[name=append_code_point]]
    fn append(mut this, anon code_point: u32)
    fn appendff(mut this, anon format: String, ..)
    fn append_escaped_for_json(mut this, anon s: String)
    fn to_string(this) -> String

    fn is_empty(this) -> bool
    fn length(this) -> usize
    fn clear(mut this)
    fn create() -> StringBuilder

    // Deprecated API
    fn append_c_string(mut this, anon s: raw c_char)
    fn append_code_point(mut this, anon code_point: u32)
}

extern struct WeakPtr<T> {
    fn has_value(this) -> bool
    fn clear(mut this)
}

extern struct Tuple {}

extern struct DictionaryIterator<K, V> {
    fn next(mut this) -> (K, V)?
}

extern struct Dictionary<K, V> {
    fn is_empty(this) -> bool
    fn get(this, anon key: K) -> V?
    fn contains(this, anon key: K) -> bool
    fn set(mut this, anon key: K, anon value: V)
    fn remove(mut this, anon key: K) -> bool
    fn ensure_capacity(mut this, anon capacity: usize)
    fn clear(mut this)
    fn size(this) -> usize
    fn capacity(this) -> usize
    fn keys(this) -> [K]
    fn hash(this) -> u32
    fn Dictionary<A, B>() -> Dictionary<A, B>
    fn iterator(this) -> DictionaryIterator<K, V>
}

extern struct SetIterator<T> {
    fn next(mut this) -> T?
}

extern struct Set<V> {
    fn is_empty(this) -> bool
    fn contains(this, anon value: V) -> bool
    fn add(mut this, anon value: V)
    fn remove(mut this, anon value: V) -> bool
    fn ensure_capacity(mut this, anon capacity: usize)
    fn clear(mut this)
    fn size(this) -> usize
    fn capacity(this) -> usize
    fn hash(this) -> u32
    fn Set<A>() -> Set<A>
    fn iterator(this) -> SetIterator<V>
}

extern struct Range<T> {
    fn Range<U>(anon start: U, anon end: U) -> Range<U>
    fn next(mut this) -> T?
    fn inclusive(this) -> Range<T>
    fn exclusive(this) -> Range<T>
}

extern struct StringView {
    fn length(this) -> usize
    [[name="operator[]"]]
    fn byte_at(this, anon index: usize) -> u8
}

extern struct Error {
    fn code(this) -> i32
    [[name=string_literal]]
    fn string(this) -> StringView

    fn from_errno(anon errno: i32) -> Error

    [[name="__jakt_from_string_literal"]]
    fn from_string_literal(anon string: StringView) -> Error
}

extern class File {
    public fn open_for_reading(anon path: String) throws -> File
    public fn open_for_writing(anon path: String) throws -> File

    public fn read(mut this, anon buffer: [u8]) throws -> usize
    public fn write(mut this, anon data: [u8]) throws -> usize

    public fn read_all(mut this) throws -> [u8]

    public fn exists(anon path: String) -> bool
    public fn current_executable_path() throws -> String
}

extern fn abort() -> never
extern fn as_saturated<U, T>(anon input: T) -> U
extern fn as_truncated<U, T>(anon input: T) -> U
extern fn unchecked_add<T>(anon a: T, anon b: T) -> T
extern fn unchecked_sub<T>(anon a: T, anon b: T) -> T
extern fn unchecked_mul<T>(anon a: T, anon b: T) -> T
extern fn unchecked_div<T>(anon a: T, anon b: T) -> T

namespace Reflect {
    struct Span {
        start: usize
        end: usize
        file: String
    }
    enum Visibility {
        Public
        Private
        // Restricted(whitelist: [Reflect::Type])
    }
    struct VariableDeclaration {
        name: String
        type: Reflect::Type
        is_mutable: bool
    }
    struct Field {
        variable: Reflect::VariableDeclaration
        visibility: Reflect::Visibility
        // comptime setter<T, U>(this) throws {
        //     let name = .variable.name
        //     return fn[name](anon s: &mut T, anon value: U) throws {
        //         Reflect::Internal::set_field(name, s, value)
        //     }
        // }
    }
    struct Method {
        function: Reflect::Function
        visibility: Reflect::Visibility
    }
    struct Function {
        name: String
        generic_parameters: [String]
        parameters: [Reflect::Parameter]
        return_type: Reflect::Type
        can_throw: bool
        is_comptime: bool
        block: [Reflect::Statement]
    }
    struct Parameter {
        name: String
        type: Reflect::Type
        requires_label: bool
        // default_value: Reflect::Expression?
    }
    boxed enum Statement {
        Expression(Reflect::Expression)
        Defer(Reflect::Statement)
        DestructuringAssignment(vars: [Reflect::Statement], var_decl: Reflect::Statement)
        VarDecl(name: String, type: Reflect::Type, init: Reflect::Expression)
        If(condition: Reflect::Expression, then_block: [Reflect::Statement], else_statement: Reflect::Statement?)
        Block([Reflect::Statement])
        Loop([Reflect::Statement])
        While(condition: Reflect::Expression, block: [Reflect::Statement])
        Return(Reflect::Expression?)
        Break
        Continue
        Throw(Reflect::Expression)
        Yield(Reflect::Expression?)
        InlineCpp([String])
    }
    enum NumericConstant {
        I8(i8)
        I16(i16)
        I32(i32)
        I64(i64)
        U8(u8)
        U16(u16)
        U32(u32)
        U64(u64)
        USize(usize)
        F32(f32)
        F64(f64)
    }
    boxed enum Typecast {
        type: Reflect::Type

        Fallible
        Infallible
        Identity
    }
    struct EnumVariantBindings {
        name: Optional<String>
        binding: String
        type: Reflect::Type
    }
    boxed enum UnaryOperator {
        PreIncrement
        PostIncrement
        PreDecrement
        PostDecrement
        Negate
        Dereference
        RawAddress
        Reference
        MutableReference
        LogicalNot
        BitwiseNot
        IsSome
        IsNone
        TypeCast(Typecast)
        Is(Type)
        IsEnumVariant(
            enum_variant: SumEnumVariant
            bindings: [EnumVariantBindings]
            type: Type
        )
    }
    enum BinaryOperator {
        Add
        Subtract
        Multiply
        Divide
        Modulo
        LessThan
        LessThanOrEqual
        GreaterThan
        GreaterThanOrEqual
        Equal
        NotEqual

        BitwiseAnd
        BitwiseXor
        BitwiseOr
        BitwiseLeftShift
        BitwiseRightShift
        ArithmeticLeftShift
        ArithmeticRightShift

        LogicalAnd
        LogicalOr

        NoneCoalescing

        Assign
        BitwiseAndAssign
        BitwiseOrAssign
        BitwiseXorAssign
        BitwiseLeftShiftAssign
        BitwiseRightShiftAssign
        AddAssign
        SubtractAssign
        MultiplyAssign
        ModuloAssign
        DivideAssign
        NoneCoalescingAssign

        Garbage
    }
    boxed enum Expression {
        Boolean(bool)
        NumericConstant(NumericConstant)
        QuotedString(String)
        ByteConstant(u8)
        CharacterConstant(u32)
        CCharacterConstant(c_char)
        UnaryOp(
            expr: Reflect::Expression,
            op: Reflect::UnaryOperator
            type: Reflect::Type
        )
        BinaryOp(
            lhs: Reflect::Expression,
            rhs: Reflect::Expression,
            op: Reflect::BinaryOperator
        )
        TupleLiteral([Reflect::Expression])
        RangeLiteral(from: Reflect::Expression?, to: Reflect::Expression?)
        ArrayLiteral(values: [Reflect::Expression], repeat: Reflect::Expression?)
        SetLiteral(values: [Reflect::Expression])
        DictionaryLiteral([(Reflect::Expression, Reflect::Expression)])
        IndexedExpression(base: Reflect::Expression, index: Reflect::Expression)
        IndexedDictionary(base: Reflect::Expression, key: Reflect::Expression)
        IndexedTuple(base: Reflect::Expression, index: usize, is_optional: bool)
        IndexedStruct(base: Reflect::Expression, name: String, is_optional: bool)
        IndexedCommonEnumMember(base: Reflect::Expression, name: String, is_optional: bool)
        ComptimeIndex(base: Reflect::Expression, index: Reflect::Expression, is_optional: bool)
        Match(
            // TODO
        )
        EnumVariantArg(
            // TODO
        )
        Call(Reflect::Call)
        MethodCall(this_expr: Reflect::Expression, call: Reflect::Call, is_optional: bool)
        NamespacedVar(
            name: String
            namespace_: [String]
        )
        Var(
            name: String
        )
        OptionalNone
        OptionalSome(Reflect::Expression)
        ForcedUnwrap(Reflect::Expression)
        Block([Reflect::Statement])
        Function(
            // TODO
        )
        DependentFunction(
            // TODO
        )
        Must(
            expr: Reflect::Expression
        )
        Try(
            expr: Reflect::Expression
            catch_block: [Reflect::Statement]
            catch_name: String?
        )
        TryBlock(
            statement: Reflect::Statement
            error_name: String
            catch_block: [Reflect::Statement]
        )
        Reflect(type: Reflect::Type)
    }
    struct Call {
        namespaces: [String]
        name: String
        args: [Reflect::Expression]
        type_args: [Reflect::Type]
        return_type: Reflect::Type
    }
    enum SumEnumVariant {
        StructLike(name: String, fields: [Reflect::Field])
        Typed(name: String, type: Reflect::Type)
        Untyped(name: String)
    }
    enum RecordType {
        Struct(fields: [Reflect::Field])
        Class(fields: [Reflect::Field])
        // FIXME: Variants should map to a value.
        ValueEnum(underlying_type: Reflect::Type, variants: [String])
        SumEnum(is_boxed: bool, variants: [Reflect::SumEnumVariant])
    }
    struct Record {
        name: String
        methods: [Reflect::Method]
        generic_mappings: [(String, Reflect::Type)]
        record_type: Reflect::RecordType
    }
    boxed enum Type {
        Void
        Bool
        U8
        U16
        U32
        U64
        I8
        I16
        I32
        I64
        F32
        F64
        Usize
        JaktString
        CChar
        CInt
        Unknown
        Never
        StructureOrEnum(Reflect::Record)
        TypeVariable(String)
        RawPtr(Reflect::Type)
        Reference(Reflect::Type)
        MutableReference(Reflect::Type)
        Function

        fn name(this) throws => match this {
            Void => "void"
            Bool => "bool"
            U8 => "u8"
            U16 => "u16"
            U32 => "u32"
            U64 => "u64"
            I8 => "i8"
            I16 => "i16"
            I32 => "i32"
            I64 => "i64"
            F32 => "f32"
            F64 => "f64"
            Usize => "usize"
            JaktString => "String"
            CChar => "c_char"
            CInt => "c_int"
            Unknown => "unknown"
            Never => "never"
            StructureOrEnum(record) => format("struct {}", record.name)
            TypeVariable(name) => format("{}", name)
            RawPtr(type) => format("raw {}", type.name())
            Reference(type) => format("& {}", type.name())
            MutableReference(type) => format("&mut {}", type.name())
            Function => "fn"
        }
    }
}

